{
  "name": "tokenfetti",
  "version": "0.2.0",
  "description": "A 420x190 macOS widget that turns local Codex / Claude Code session burn into a real-time dopamine scoreboard",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "verify:claude-parser": "node scripts/verify-claude-parser.js",
    "verify:multi": "node scripts/verify-multi-provider.js",
    "verify:all": "npm run verify:claude-parser && npm run verify:multi",
    "pack:mac": "electron-builder --mac dir",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.john.tokenfetti",
    "productName": "Tokenfetti",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "title": "${productName} ${version}"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.8.1"
  }
}
